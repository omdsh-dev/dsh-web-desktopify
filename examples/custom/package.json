{
  "name": "dsh-custom",
  "version": "0.1.3",
  "private": true,
  "dependencies": {
    "@morlay/better-session": "^0.0.16-alpha.0",
    "@morlay/dsh-llm-openai-compatible": "^0.0.4-alpha.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.3-alpha.2",
    "tsx": "*"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "@morlay/better-session",
        "@morlay/dsh-llm-openai-compatible"
      ]
    },
    "desktop": {
      "id": "ai.deepseek.dsh.custom",
      "window": {
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      },
      "icon": "icon.svg",
      "dshHome": "xdg"
    }
  }
}

{
  "name": "dsh-custom",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@morlay/better-session": "^0.0.11",
    "@morlay/dsh-llm-openai-compatible": "^0.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "@morlay/better-session",
        "@morlay/dsh-llm-openai-compatible"
      ]
    },
    "desktop": {
      "id": "ai.deepseek.dsh.custom",
      "window": {
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      },
      "icon": "icon.svg",
      "dshHome": "xdg"
    }
  }
}
